Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On
# The original prerendered Svelte homepage contains obsolete demo cards.
# Never let Apache serve that file instead of the real CMS homepage.
RewriteRule ^index\.html$ / [R=302,L]
# Old static search used demo articles; use the MySQL-backed search instead.
RewriteRule ^search/?$ api/stories.php [L,QSA]
# Serve the CMS homepage; NEVER fall back to old showcase content.
RewriteRule ^$ api/homepage.php [L,QSA]
# Authenticated draft preview is never indexable.
RewriteRule ^editorial-preview/?$ api/homepage.php?preview=1 [L,QSA]
# Server-rendered, indexable articles from the REAL CMS database.
RewriteRule ^stories/?$ api/stories.php [L,QSA]
RewriteRule ^stories/([a-z0-9-]+)/?$ api/story.php?slug=$1 [L,QSA]
RewriteRule ^sitemap-cms\.xml$ api/sitemap.php [L,QSA]
# Dynamic article category pages use the same editorial database, not static demo content.
RewriteRule ^category/([a-z0-9-]+)/?$ api/stories.php?category=$1 [L,QSA]
# The old prerendered sitemap must never advertise the sample article URLs.
RewriteRule ^sitemap\.xml$ api/sitemap.php [L,QSA]
# Retire legacy prerendered demo articles from public navigation.
# Temporary redirects until the final production URL migration.
RewriteRule ^article/elderly-care-at-home/?$ /stories/choose-elderly-caregiver-at-home/ [R=302,L]
RewriteRule ^article/safe-home-for-seniors/?$ /stories/prevent-falls-elderly-home/ [R=302,L]
RewriteRule ^article/choose-a-walker/?$ /stories/choose-walker-for-elderly/ [R=302,L]
RewriteRule ^article/senior-nutrition/?$ /stories/elderly-nutrition-poor-appetite/ [R=302,L]
RewriteRule ^article/caregiver-communication/?$ /stories/communication-with-dementia-older-adult/ [R=302,L]
RewriteRule ^article/family-care-plan/?$ /stories/choose-elderly-caregiver-at-home/ [R=302,L]
RewriteRule ^article/[a-z0-9-]+/?$ /stories/ [R=302,L]
# Preserve existing SvelteKit prerendered HTML pages and directory slugs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
ErrorDocument 404 /404.html
