Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# Live MYCA editorial homepage uses the published layout; falls back to old index.html before first publish.
RewriteRule ^$ api/homepage.php [L,QSA]
# Authenticated draft preview is never indexable.
RewriteRule ^editorial-preview/?$ api/homepage.php?preview=1 [L,QSA]
# Server-rendered, indexable articles from the REAL CMS database.
RewriteRule ^stories/?$ api/stories.php [L,QSA]
RewriteRule ^stories/([a-z0-9-]+)/?$ api/story.php?slug=$1 [L,QSA]
RewriteRule ^sitemap-cms\.xml$ api/sitemap.php [L,QSA]
# Dynamic article category pages use the same editorial database, not static demo content.
RewriteRule ^category/([a-z0-9-]+)/?$ api/stories.php?category=$1 [L,QSA]
# The old prerendered sitemap must never advertise the sample article URLs.
RewriteRule ^sitemap\.xml$ api/sitemap.php [L,QSA]
# Preserve existing SvelteKit prerendered HTML pages and directory slugs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
ErrorDocument 404 /404.html
